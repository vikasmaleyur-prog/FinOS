# FinOS - Environment Variables Example
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Google Gemini API Key for Ask FinOS AI Financial Advisor (Optional)
# If omitted or offline, FinOS runs with 100% deterministic local financial heuristics and fallback explanations.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Frontend API Target
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
